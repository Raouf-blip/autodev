{
    "require": {
        "php": ">=8.2",
        "slim/slim": "^4.0",
        "slim/psr7": "^1.6",
        "twig/twig": "3.*",
        "illuminate/database": "11.*",
        "ext-pdo": "*",
        "monolog/monolog": "^3.0",
        "zircote/swagger-php": "^4.0",
        "php-di/php-di": "^7.0",
        "slim/http": "^1.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "kylekatarnls/update-helper": true
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit tests/Functional/RacoinTest.php",
        "swagger": "vendor/bin/openapi src/ -o public/openapi.json"
    }
}
